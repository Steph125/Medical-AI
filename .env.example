# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

PORT=8080
# URL du front (plusieurs possibles, séparées par des virgules) : CORS et liens dans les emails
FRONTEND_URL=http://localhost:8081

# MongoDB
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Secret de signature des JWT (obligatoire). Générer avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Compte Gmail d'envoi des emails (mot de passe d'application Google)
USER_EMAIL=
USER_PASS=

# Dialogflow - chatbot de symptômes (/chatbot)
SYMPTOM_DIALOGFLOW_PROJECT_ID=
SYMPTOM_DIALOGFLOW_CLIENT_EMAIL=
# Clé privée sur une ligne, avec les retours à la ligne écrits \n
SYMPTOM_DIALOGFLOW_PRIVATE_KEY=

# Dialogflow - chatbot de prise de rendez-vous (/ChatApp)
APPOINTMENT_DIALOGFLOW_PROJECT_ID=
APPOINTMENT_DIALOGFLOW_CLIENT_EMAIL=
APPOINTMENT_DIALOGFLOW_PRIVATE_KEY=

DIALOGFLOW_LANGUAGE_CODE=en-US

# Stripe
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=eur

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/oauth
