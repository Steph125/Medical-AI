
<!DOCTYPE html>
<html>
  <head>
    <title>Loading...</title>
  </head>
  <body>
    <h1>Login Successful</h1>
  </body>
  <script>
    // JSON échappé ("<" -> <) pour qu'une valeur ne puisse pas fermer la balise <script>.
    var data = <%- JSON.stringify({ type: 'profile', profile: profile, auth: auth, state: state }).replace(/</g, '\\u003c') %>;
    // Message envoyé uniquement à l'origine du front, jamais à '*'.
    window.opener.postMessage(data, <%- JSON.stringify(targetOrigin).replace(/</g, '\\u003c') %>);
    window.close();
  </script>
</html>
